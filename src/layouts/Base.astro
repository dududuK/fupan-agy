---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '真实操作 · 认知经验 · 数据做证人' } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: '总览', active: pathname === '/' },
  { href: '/logs', label: '复盘档案', active: pathname.startsWith('/logs') },
  { href: '/playbook', label: '战法手册', active: pathname.startsWith('/playbook') },
  { href: '/rules', label: '交易铁律', active: pathname.startsWith('/rules') },
];
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === '复盘手账' ? '复盘手账 · 实盘交易复盘台' : `${title} · 复盘手账`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('fupan-theme');
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--canvas)] text-[var(--ink)] antialiased selection:bg-[var(--accent)]/20">
    <header class="sticky top-0 z-30 h-14 border-b border-[var(--line)] bg-[var(--canvas)]/90 backdrop-blur-md">
      <div class="max-w-[1320px] mx-auto h-full px-5 sm:px-8 flex items-center justify-between gap-8">
        <!-- Zone 1: Single-element wordmark -->
        <a
          href="/"
          class="text-base font-bold tracking-tight text-[var(--ink)] hover:text-[var(--accent)] transition-colors duration-150 whitespace-nowrap shrink-0"
        >
          复盘手账
        </a>

        <!-- Zone 2: Clean single-line text nav links -->
        <nav aria-label="主导航" class="flex items-center gap-5 sm:gap-8 overflow-x-auto no-scrollbar">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'relative py-4 text-sm font-medium transition-colors duration-150 whitespace-nowrap shrink-0',
                item.active
                  ? 'text-[var(--ink)] after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-[var(--accent)]'
                  : 'text-[var(--ink-secondary)] hover:text-[var(--ink)]',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Zone 3: Single primary action (Theme switcher) -->
        <div class="shrink-0">
          <button
            id="theme-toggle"
            type="button"
            class="h-9 px-3.5 text-xs font-medium border border-[var(--line-strong)] bg-[var(--surface)] text-[var(--ink)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors duration-150 whitespace-nowrap shrink-0 cursor-pointer"
            aria-label="切换页面明暗主题"
          >
            <span class="hidden dark:inline">切换浅色</span>
            <span class="inline dark:hidden">切换暗色</span>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1 w-full max-w-[1320px] mx-auto px-5 sm:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-[var(--line)] mt-16">
      <div class="max-w-[1320px] mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[var(--ink-muted)]">
        <p>复盘手账 · 真实操作 · 认知经验 · 数据做证人</p>
        <div class="flex items-center gap-6">
          <a href="/" class="hover:text-[var(--ink)] transition-colors whitespace-nowrap">总览</a>
          <a href="/playbook" class="hover:text-[var(--ink)] transition-colors whitespace-nowrap">战法手册</a>
          <a href="/rules" class="hover:text-[var(--ink)] transition-colors whitespace-nowrap">交易铁律</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const nextIsDark = !root.classList.contains('dark');
        root.classList.toggle('dark', nextIsDark);
        try {
          localStorage.setItem('fupan-theme', nextIsDark ? 'dark' : 'light');
        } catch {}
        window.dispatchEvent(new CustomEvent('fupan:theme-change', { detail: { dark: nextIsDark } }));
      });
    </script>
  </body>
</html>
