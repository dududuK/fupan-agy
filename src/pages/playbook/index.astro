---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLogsSorted, aggregatePatternStats } from '../../lib/trades';

const playbook = (await getCollection('playbook')).sort((a, b) => a.id.localeCompare(b.id));
const logs = await getLogsSorted();
const stats = aggregatePatternStats(logs);
const statByPattern = new Map(stats.map((s) => [s.pattern, s]));
---

<Base title="战法手册" description="出手必须有所据。每个战法都对应实盘胜率与交割案例。">
  <header class="pb-8 border-b border-[var(--line)] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--ink)]">战法手册</h1>
      <p class="mt-2 text-sm text-[var(--ink-secondary)]">
        出手必须有所据。每一套战法都绑定实盘交割样本与胜率统计。
      </p>
    </div>
    <span class="font-mono text-xs tabular-nums text-[var(--ink-muted)]">
      共登记 {playbook.length} 套模式
    </span>
  </header>

  {playbook.length === 0 ? (
    <div class="mt-8 border border-[var(--line)] bg-[var(--surface)] p-10 text-center text-sm text-[var(--ink-muted)]">
      暂无战法手册记录。
    </div>
  ) : (
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {playbook.map((p, idx) => {
        const key = p.data.pattern ?? p.data.title;
        const st = statByPattern.get(key);
        return (
          <a
            href={`/playbook/${p.id}`}
            class="group flex flex-col justify-between border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--accent)] transition-colors duration-150"
          >
            <div class="p-6">
              <div class="flex items-center justify-between gap-3 text-xs font-mono text-[var(--ink-muted)]">
                <span>模式 {String(idx + 1).padStart(2, '0')}</span>
                <span>标签：{key}</span>
              </div>

              <h2 class="mt-3 text-xl font-bold text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
                {p.data.title}
              </h2>

              {p.data.description && (
                <p class="mt-2.5 text-sm leading-relaxed text-[var(--ink-secondary)]">
                  {p.data.description}
                </p>
              )}
            </div>

            <div class="px-6 py-4 border-t border-[var(--line)] bg-[var(--surface-subtle)]/50 grid grid-cols-3 gap-4 font-mono text-xs tabular-nums">
              <div>
                <div class="text-[var(--ink-muted)]">实盘出手</div>
                <div class="mt-1 font-semibold text-[var(--ink)]">{st ? `${st.total} 笔` : '0 笔'}</div>
              </div>
              <div>
                <div class="text-[var(--ink-muted)]">已决胜率</div>
                <div
                  class:list={[
                    'mt-1 font-semibold',
                    st?.winRate == null
                      ? 'text-[var(--ink-muted)]'
                      : st.winRate >= 0.5
                        ? 'text-[var(--gain)]'
                        : 'text-[var(--loss)]',
                  ]}
                >
                  {st?.winRate == null ? '—' : `${(st.winRate * 100).toFixed(1)}%`}
                </div>
              </div>
              <div class="text-right">
                <div class="text-[var(--ink-muted)]">均盈亏</div>
                <div
                  class:list={[
                    'mt-1 font-semibold',
                    st?.avgPnl == null
                      ? 'text-[var(--ink-muted)]'
                      : st.avgPnl >= 0
                        ? 'text-[var(--gain)]'
                        : 'text-[var(--loss)]',
                  ]}
                >
                  {st?.avgPnl == null
                    ? '—'
                    : `${st.avgPnl > 0 ? '+' : ''}${st.avgPnl.toFixed(1)}%`}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  )}
</Base>
