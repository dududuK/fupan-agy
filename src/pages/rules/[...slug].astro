---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const rules = await getCollection('rules');
  return rules.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title}>
  <nav aria-label="面包屑导航" class="mb-6 flex items-center gap-2 text-xs text-[var(--ink-muted)] font-mono">
    <a href="/" class="hover:text-[var(--ink)] transition-colors">总览</a>
    <span aria-hidden="true">/</span>
    <a href="/rules" class="hover:text-[var(--ink)] transition-colors">交易铁律</a>
    <span aria-hidden="true">/</span>
    <span class="text-[var(--ink-secondary)]">{entry.data.title}</span>
  </nav>

  <header class="pb-8 border-b border-[var(--line)]">
    <div class="text-xs font-mono text-[var(--accent)]">核心风控纲领</div>
    <h1 class="mt-2.5 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--ink)]">
      {entry.data.title}
    </h1>
  </header>

  <article class="mt-8 border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-10">
    <div class="prose-ledger max-w-[74ch]">
      <Content />
    </div>
  </article>

  <div class="mt-8 flex items-center justify-between text-xs">
    <a href="/rules" class="text-[var(--ink-secondary)] hover:text-[var(--accent)] transition-colors">
      ← 返回铁律列表
    </a>
    <a href="/playbook" class="text-[var(--accent)] hover:text-[var(--accent-hover)] transition-colors">
      前往战法手册 →
    </a>
  </div>
</Base>
