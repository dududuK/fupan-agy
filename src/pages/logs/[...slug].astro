---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  formatCurrency,
  getComputedLedger,
} from '../../lib/trades';

export async function getStaticPaths() {
  const { logs, ledger } = await getComputedLedger();
  return logs.map((log, index) => ({
    params: { slug: log.id },
    props: {
      log,
      snapshot: ledger.bySlug.get(log.id) ?? null,
      newer: index > 0 ? logs[index - 1] : null,
      older: index < logs.length - 1 ? logs[index + 1] : null,
    },
  }));
}

const { log, snapshot, newer, older } = Astro.props;
const { Content } = await render(log);
const d = log.data.date.toISOString().slice(0, 10);

const playbook = await getCollection('playbook');
const patternToSlug = new Map(
  playbook.map((p) => [p.data.pattern ?? p.data.title, `/playbook/${p.id}`])
);
const usedPatterns = [...new Set(log.data.trades.map((t) => t.pattern))];

const resultText: Record<string, string> = {
  WIN: '止盈 WIN',
  LOSS: '止损 LOSS',
  HOLD: '持仓 HOLD',
};
---

<Base title={log.data.title} description={log.data.summary}>
  <!-- Breadcrumb -->
  <nav aria-label="面包屑导航" class="mb-6 flex items-center gap-2 text-xs text-[var(--ink-muted)] font-mono">
    <a href="/" class="hover:text-[var(--ink)] transition-colors">总览</a>
    <span aria-hidden="true">/</span>
    <a href="/logs" class="hover:text-[var(--ink)] transition-colors">复盘档案</a>
    <span aria-hidden="true">/</span>
    <span class="text-[var(--ink-secondary)]">{d}</span>
  </nav>

  <!-- Editorial Memo Header -->
  <header class="pb-8 border-b border-[var(--line)]">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono tabular-nums text-[var(--ink-muted)]">
      <span>{d}</span>
      {snapshot && (
        <>
          <span aria-hidden="true">·</span>
          <span>总资产 {formatCurrency(snapshot.totalEquity)}</span>
          <span aria-hidden="true">·</span>
          <span>净值 {snapshot.netValue.toFixed(3)}</span>
          <span aria-hidden="true">·</span>
          <span
            class={
              snapshot.dailyPnl > 0
                ? 'text-[var(--gain)]'
                : snapshot.dailyPnl < 0
                  ? 'text-[var(--loss)]'
                  : ''
            }
          >
            当日 {formatCurrency(snapshot.dailyPnl, true)} ({snapshot.dailyReturnPct > 0 ? '+' : ''}{snapshot.dailyReturnPct.toFixed(2)}%)
          </span>
        </>
      )}
      <span aria-hidden="true">·</span>
      <span>纪律 {snapshot ? `${snapshot.discipline}/10 (${snapshot.disciplineAudit.grade})` : '—'}</span>
    </div>

    <h1 class="mt-3 text-2xl sm:text-4xl font-bold tracking-tight text-[var(--ink)] max-w-4xl leading-tight">
      {log.data.title}
    </h1>
    <p class="mt-4 text-base text-[var(--ink-secondary)] max-w-3xl leading-relaxed">
      {log.data.summary}
    </p>
  </header>

  <!-- Execution Ledger Table with Real Fee & Share Accounting -->
  {snapshot && snapshot.executions.length > 0 && (
    <section class="my-8 border border-[var(--line)] bg-[var(--surface)]">
      <div class="px-5 py-3 border-b border-[var(--line)] flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-xs font-semibold text-[var(--ink)]">当日交割与资金核算明细</h2>
        <span class="font-mono text-xs text-[var(--ink-muted)] tabular-nums">
          共 {snapshot.executions.length} 笔 · 费用合计 {formatCurrency(snapshot.dayFees)}
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-[var(--line)] bg-[var(--surface-subtle)]/60 text-xs text-[var(--ink-muted)]">
              <th class="py-2.5 pl-5 pr-3 text-left font-medium font-mono">代码</th>
              <th class="py-2.5 px-3 text-left font-medium">标的</th>
              <th class="py-2.5 px-3 text-left font-medium">战法</th>
              <th class="py-2.5 px-3 text-left font-medium">方向</th>
              <th class="py-2.5 px-3 text-right font-medium font-mono">成交价</th>
              <th class="py-2.5 px-3 text-right font-medium font-mono">股数</th>
              <th class="py-2.5 px-3 text-right font-medium font-mono">成交额</th>
              <th class="py-2.5 px-3 text-right font-medium font-mono">税费</th>
              <th class="py-2.5 px-3 text-left font-medium">状态</th>
              <th class="py-2.5 pl-3 pr-5 text-right font-medium font-mono">已实现盈亏</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--line)]">
            {snapshot.executions.map(({ trade: t, shares, grossAmount, fee, realizedPnl }) => (
              <tr class="hover:bg-[var(--surface-subtle)]/50 transition-colors">
                <td class="py-3 pl-5 pr-3 font-mono text-xs tabular-nums text-[var(--ink-secondary)]">
                  {t.code}
                </td>
                <td class="py-3 px-3 font-medium text-[var(--ink)] whitespace-nowrap">{t.name}</td>
                <td class="py-3 px-3 whitespace-nowrap">
                  {patternToSlug.has(t.pattern) ? (
                    <a
                      href={patternToSlug.get(t.pattern)}
                      class="text-[var(--accent)] hover:text-[var(--accent-hover)] underline decoration-[var(--accent)]/40 underline-offset-4"
                    >
                      {t.pattern}
                    </a>
                  ) : (
                    <span class="text-[var(--ink-secondary)]">{t.pattern}</span>
                  )}
                </td>
                <td class="py-3 px-3 font-mono text-xs whitespace-nowrap">
                  <span class={t.action === 'BUY' ? 'text-[var(--accent)] font-semibold' : 'text-[var(--gain)] font-semibold'}>
                    {t.action === 'BUY' ? '买入 BUY' : '卖出 SELL'}
                  </span>
                </td>
                <td class="py-3 px-3 text-right font-mono tabular-nums text-[var(--ink)]">
                  {t.price.toFixed(2)}
                </td>
                <td class="py-3 px-3 text-right font-mono tabular-nums text-[var(--ink-secondary)]">
                  {Math.round(shares).toLocaleString('zh-CN')}
                </td>
                <td class="py-3 px-3 text-right font-mono tabular-nums text-[var(--ink-secondary)]">
                  {formatCurrency(grossAmount)}
                </td>
                <td class="py-3 px-3 text-right font-mono text-xs tabular-nums text-[var(--ink-muted)]">
                  {formatCurrency(fee)}
                </td>
                <td class="py-3 px-3 font-mono text-xs whitespace-nowrap text-[var(--ink-secondary)]">
                  {t.result ? (resultText[t.result] ?? t.result) : '—'}
                </td>
                <td class="py-3 pl-3 pr-5 text-right font-mono tabular-nums whitespace-nowrap">
                  {realizedPnl != null ? (
                    <span class={realizedPnl >= 0 ? 'text-[var(--gain)] font-semibold' : 'text-[var(--loss)] font-semibold'}>
                      {formatCurrency(realizedPnl, true)}
                      {t.pnl_pct != null ? ` (${t.pnl_pct > 0 ? '+' : ''}${t.pnl_pct}%)` : ''}
                    </span>
                  ) : (
                    <span class="text-[var(--ink-muted)]">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Asymmetric Two-Column Reading Canvas -->
  <div class="mt-8 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-10 items-start">
    <article class="prose-ledger max-w-[74ch]">
      <Content />
    </article>

    <aside class="lg:sticky lg:top-20 flex flex-col gap-6">
      <div class="border border-[var(--line)] bg-[var(--surface)]">
        <div class="px-4 py-3 border-b border-[var(--line)] text-xs font-semibold text-[var(--ink)]">
          当日账户快照
        </div>
        <dl class="divide-y divide-[var(--line)] text-xs">
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">收盘总资产</dt>
            <dd class="font-mono tabular-nums font-semibold text-[var(--ink)]">
              {snapshot ? formatCurrency(snapshot.totalEquity) : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">可用现金</dt>
            <dd class="font-mono tabular-nums text-[var(--ink)]">
              {snapshot ? formatCurrency(snapshot.cash) : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">持仓市值</dt>
            <dd class="font-mono tabular-nums text-[var(--ink)]">
              {snapshot ? formatCurrency(snapshot.marketValue) : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">当日盈亏</dt>
            <dd
              class:list={[
                'font-mono tabular-nums font-semibold',
                !snapshot || snapshot.dailyPnl === 0
                  ? 'text-[var(--ink-secondary)]'
                  : snapshot.dailyPnl > 0
                    ? 'text-[var(--gain)]'
                    : 'text-[var(--loss)]',
              ]}
            >
              {snapshot ? formatCurrency(snapshot.dailyPnl, true) : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">累计总盈亏</dt>
            <dd
              class:list={[
                'font-mono tabular-nums',
                !snapshot || snapshot.cumulativePnl === 0
                  ? 'text-[var(--ink-secondary)]'
                  : snapshot.cumulativePnl > 0
                    ? 'text-[var(--gain)]'
                    : 'text-[var(--loss)]',
              ]}
            >
              {snapshot ? `${formatCurrency(snapshot.cumulativePnl, true)} (${snapshot.cumulativeReturnPct > 0 ? '+' : ''}${snapshot.cumulativeReturnPct.toFixed(2)}%)` : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">账户净值</dt>
            <dd class="font-mono tabular-nums text-[var(--ink)]">
              {snapshot ? snapshot.netValue.toFixed(3) : '—'}
            </dd>
          </div>
          <div class="px-4 py-3 flex items-center justify-between">
            <dt class="text-[var(--ink-muted)]">纪律评分</dt>
            <dd class="font-mono tabular-nums font-semibold text-[var(--ink)]">
              {snapshot ? `${snapshot.discipline} / 10` : '—'}
            </dd>
          </div>
        </dl>
      </div>

      {snapshot && (
        <div class="border border-[var(--line)] bg-[var(--surface)]">
          <div class="px-4 py-3 border-b border-[var(--line)] flex items-center justify-between gap-2">
            <span class="text-xs font-semibold text-[var(--ink)]">铁律纪律核算</span>
            <a href="/rules/iron-rules" class="text-[11px] font-mono text-[var(--accent)] hover:text-[var(--accent-hover)]">
              标准 →
            </a>
          </div>
          <div class="px-4 py-3 space-y-2.5 text-xs">
            <div class="flex items-baseline justify-between font-mono tabular-nums">
              <span class="text-[var(--ink-muted)]">评级 · {snapshot.disciplineAudit.grade}</span>
              <span class="font-semibold text-[var(--ink)]">
                10 - {snapshot.disciplineAudit.totalDeducted} = {snapshot.discipline}分
              </span>
            </div>
            {snapshot.disciplineAudit.deductions.length === 0 ? (
              <p class="text-[var(--ink-secondary)] pt-2 border-t border-[var(--line)] leading-relaxed">
                R1–R5 全部铁律核查通过，无违纪扣分。
              </p>
            ) : (
              <ul class="pt-2 border-t border-[var(--line)] space-y-2">
                {snapshot.disciplineAudit.deductions.map((d) => (
                  <li class="flex items-start justify-between gap-2">
                    <span class="text-[var(--ink-secondary)] leading-snug">
                      <span class="font-mono text-[var(--ink-muted)] mr-1">{d.code}</span>
                      {d.reason}
                    </span>
                    <span class="font-mono font-semibold tabular-nums text-[var(--loss)] shrink-0">
                      -{d.points}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )}

      {snapshot && snapshot.holdings.length > 0 && (
        <div class="border border-[var(--line)] bg-[var(--surface)]">
          <div class="px-4 py-3 border-b border-[var(--line)] text-xs font-semibold text-[var(--ink)]">
            收盘持仓
          </div>
          <ul class="divide-y divide-[var(--line)] text-xs font-mono tabular-nums">
            {snapshot.holdings.map((h) => (
              <li class="px-4 py-3 space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-sans font-medium text-[var(--ink)]">{h.name}</span>
                  <span class="text-[var(--ink-muted)]">{h.code}</span>
                </div>
                <div class="flex items-center justify-between text-[11px] text-[var(--ink-secondary)]">
                  <span>{Math.round(h.shares)}股 · 成本 {h.avgCost.toFixed(2)}</span>
                  <span>{formatCurrency(h.marketValue)}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}

      {usedPatterns.length > 0 && (
        <div class="border border-[var(--line)] bg-[var(--surface)]">
          <div class="px-4 py-3 border-b border-[var(--line)] text-xs font-semibold text-[var(--ink)]">
            涉及战法
          </div>
          <ul class="divide-y divide-[var(--line)] text-xs">
            {usedPatterns.map((pattern) => (
              <li class="px-4 py-3 flex items-center justify-between gap-2">
                {patternToSlug.has(pattern) ? (
                  <a
                    href={patternToSlug.get(pattern)}
                    class="text-[var(--accent)] hover:text-[var(--accent-hover)] font-medium"
                  >
                    {pattern} →
                  </a>
                ) : (
                  <span class="text-[var(--ink-secondary)]">{pattern}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="border border-[var(--line)] bg-[var(--surface)] divide-y divide-[var(--line)] text-xs">
        {newer && (
          <a
            href={`/logs/${newer.id}`}
            class="block px-4 py-3 hover:bg-[var(--surface-subtle)]/60 transition-colors"
          >
            <div class="text-[var(--ink-muted)] font-mono">下一篇 · {newer.data.date.toISOString().slice(0, 10)}</div>
            <div class="mt-1 font-medium text-[var(--ink)] truncate">{newer.data.title}</div>
          </a>
        )}
        {older && (
          <a
            href={`/logs/${older.id}`}
            class="block px-4 py-3 hover:bg-[var(--surface-subtle)]/60 transition-colors"
          >
            <div class="text-[var(--ink-muted)] font-mono">上一篇 · {older.data.date.toISOString().slice(0, 10)}</div>
            <div class="mt-1 font-medium text-[var(--ink)] truncate">{older.data.title}</div>
          </a>
        )}
        <a
          href="/logs"
          class="block px-4 py-3 text-[var(--accent)] hover:bg-[var(--surface-subtle)]/60 transition-colors font-medium"
        >
          ← 返回复盘档案
        </a>
      </div>
    </aside>
  </div>
</Base>
